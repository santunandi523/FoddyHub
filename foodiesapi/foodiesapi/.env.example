# Copy this file to .env and fill in real values for production.
# The Spring Boot app reads these as environment variables at startup.

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/foodsResturant

# AWS S3 credentials
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key

# JWT signing secret (use a long random string in production)
JWT_SECRET=your_super_secret_jwt_key_here

# Razorpay payment gateway keys
RAZORPAY_API_KEY=rzp_live_XXXXXXXXXXXX
RAZORPAY_SECRET_KEY=your_razorpay_secret

# Comma-separated list of frontend origins allowed to access the API
ALLOWED_ORIGINS=https://your-frontend.com,https://your-admin.com

# AI Assistant & LLM Configuration (supports gemini or openai)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
# Optional OpenAI configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
